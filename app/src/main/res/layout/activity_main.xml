<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- STOCKS -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Stocks" android:textSize="20sp" android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:alpha="0.75" android:textSize="13sp"
            android:text="Comma-separated symbols.\nIndia NSE: RELIANCE.NS, TCS.NS · BSE: RELIANCE.BO\nUS: AAPL, TSLA, MSFT\nIndices: ^NSEI (Nifty), ^BSESN (Sensex), ^GSPC (S&amp;P 500), ^IXIC (Nasdaq)" />
        <CheckBox
            android:id="@+id/cbStocks"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Show stock prices line" />
        <EditText
            android:id="@+id/etSymbols"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="^NSEI, RELIANCE.NS, AAPL"
            android:inputType="textCapCharacters|textMultiLine|textNoSuggestions"
            android:minLines="2" />
        <HorizontalScrollView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/quickAdd"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Update stocks every (seconds)" />
            <EditText
                android:id="@+id/etStockSec"
                android:layout_width="80dp" android:layout_height="wrap_content"
                android:gravity="center" android:inputType="number" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginVertical="16dp" android:background="?android:attr/listDivider" />

        <!-- SPORTS -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Sports scores" android:textSize="20sp" android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:alpha="0.75" android:textSize="13sp"
            android:text="Free live scores from ESPN. No key and no daily limit. Tick the sports you follow; they show as their own line in the ticker." />
        <CheckBox
            android:id="@+id/cbSports"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Show sports line" />
        <LinearLayout
            android:id="@+id/sportsList"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <EditText
            android:id="@+id/etTeams"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Only these teams (optional), e.g. India, MI, Arsenal"
            android:inputType="textCapWords" android:singleLine="true" />
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Update scores every (seconds)" />
            <EditText
                android:id="@+id/etSportsSec"
                android:layout_width="80dp" android:layout_height="wrap_content"
                android:gravity="center" android:inputType="number" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginVertical="16dp" android:background="?android:attr/listDivider" />

        <!-- NEWS -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Local news" android:textSize="20sp" android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:alpha="0.75" android:textSize="13sp"
            android:text="Free headlines from Google News for your city. No key and no daily limit. Shows as its own line in the ticker." />
        <CheckBox
            android:id="@+id/cbNews"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Show news line" />
        <EditText
            android:id="@+id/etCity"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Your city, e.g. Mumbai, Pune, Bengaluru"
            android:inputType="textCapWords" android:singleLine="true" />
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Update news every (minutes)" />
            <EditText
                android:id="@+id/etNewsMin"
                android:layout_width="80dp" android:layout_height="wrap_content"
                android:gravity="center" android:inputType="number" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginVertical="16dp" android:background="?android:attr/listDivider" />

        <!-- LOOK -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ticker style" android:textSize="20sp" android:textStyle="bold" />
        <RadioGroup
            android:id="@+id/rgStyle"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rbTop"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Top strip (scrolling)" />
            <RadioButton android:id="@+id/rbFloating"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Floating card (drag anywhere)" />
            <RadioButton android:id="@+id/rbBottom"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Bottom bar (scrolling)" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvTextSize"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />
        <SeekBar
            android:id="@+id/sbTextSize"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:min="10" android:max="22" />
        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />
        <SeekBar
            android:id="@+id/sbSpeed"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:min="20" android:max="160" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="Save and start ticker" />
        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Stop ticker" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:alpha="0.75" android:textSize="13sp"
            android:text="Turn each line (stocks, sports, news) on or off on its own. Tips: drag the ticker to move it. Long-press it to come back to these settings. You can also stop it from the notification." />
    </LinearLayout>
</ScrollView>
