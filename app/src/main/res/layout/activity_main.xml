<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- STOCKS -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Stocks" android:textSize="20sp" android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:alpha="0.75" android:textSize="13sp"
            android:text="Comma-separated symbols.\nIndia NSE: RELIANCE.NS, TCS.NS · BSE: RELIANCE.BO\nUS: AAPL, TSLA, MSFT\nIndices: ^NSEI (Nifty), ^BSESN (Sensex), ^GSPC (S&amp;P 500), ^IXIC (Nasdaq)" />
        <EditText
            android:id="@+id/etSymbols"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="^NSEI, RELIANCE.NS, AAPL"
            android:inputType="textCapCharacters|textMultiLine|textNoSuggestions"
            android:minLines="2" />
        <HorizontalScrollView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/quickAdd"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Update stocks every (seconds)" />
            <EditText
                android:id="@+id/etStockSec"
                android:layout_width="80dp" android:layout_height="wrap_content"
                android:gravity="center" android:inputType="number" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginVertical="16dp" android:background="?android:attr/listDivider" />

        <!-- CRICKET -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Cricket" android:textSize="20sp" android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:alpha="0.75" android:textSize="13sp"
            android:text="Get a free API key at cricketdata.org (sign up → your key is on the dashboard). Free plan = 100 updates per day." />
        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Paste CricketData API key"
            android:inputType="text|textNoSuggestions" android:singleLine="true" />
        <Button
            android:id="@+id/btnLoadMatches"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Load current matches" />
        <TextView
            android:id="@+id/tvMatchStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textSize="13sp" />
        <LinearLayout
            android:id="@+id/matchList"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Update score every (seconds)\n120 sec ≈ 3 hrs of free updates/day" />
            <EditText
                android:id="@+id/etCricketSec"
                android:layout_width="80dp" android:layout_height="wrap_content"
                android:gravity="center" android:inputType="number" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginVertical="16dp" android:background="?android:attr/listDivider" />

        <!-- LOOK -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ticker style" android:textSize="20sp" android:textStyle="bold" />
        <RadioGroup
            android:id="@+id/rgStyle"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rbTop"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Top strip (scrolling)" />
            <RadioButton android:id="@+id/rbFloating"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Floating card (drag anywhere)" />
            <RadioButton android:id="@+id/rbBottom"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Bottom bar (scrolling)" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvTextSize"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />
        <SeekBar
            android:id="@+id/sbTextSize"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:min="10" android:max="22" />
        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />
        <SeekBar
            android:id="@+id/sbSpeed"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:min="20" android:max="160" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="Save and start ticker" />
        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Stop ticker" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:alpha="0.75" android:textSize="13sp"
            android:text="Tips: drag the ticker to move it. Long-press it to come back to these settings. You can also stop it from the notification." />
    </LinearLayout>
</ScrollView>
